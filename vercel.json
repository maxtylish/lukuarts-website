{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lukuarts.com" }],
      "destination": "https://lukuarts.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://lukuarts-visual.firebaseapp.com/__/auth/:path*"
    }
  ]
}
